{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "https://pitchbook.expo.app",
      "statusCode": 302
    },
    {
      "source": "/flutterwave-redirect/:path*",
      "destination": "https://pitchbook.expo.app/flutterwave-redirect/:path*",
      "statusCode": 302
    }
  ]
}
